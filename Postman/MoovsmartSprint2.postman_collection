							"    console.log(\"Full response:\", JSON.stringify(responseJson, null, 2));\r",
							"    \r",
							"    if (responseJson && responseJson.id) {\r",
							"        pm.environment.set(\"user_id\", responseJson.id);\r",
							"        console.log(\"User ID saved:\", responseJson.id);\r",
							"    } else {\r",
							"        console.log(\"No user ID found in response. Response was:\", responseJson);\r",
							"    }\r",
							"} catch (error) {\r",
							"    console.log(\"Could not parse response as JSON or extract ID:\", error.message);\r",
							"    console.log(\"Raw response:\", pm.response.text());\r",
